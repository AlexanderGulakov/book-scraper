# Зразок. Скопіюйте в .env поруч і підставте свої значення:
#     copy .env.example .env
#
# .env стоїть у .gitignore і в репозиторій не потрапляє — це важливо,
# бо репозиторій публічний. .env.example (цей файл) комітиться, бо в ньому
# самі лише заглушки.
#
# Лапки й пробіли навколо значень не потрібні — вони все одно зрізаються.
# У GitHub Actions цей файл не потрібен: там ті самі імена приходять
# із секретів, і вони мають пріоритет над .env.

# ── Telegram ────────────────────────────────────────────────────────────────
# Токен видає @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAA-ваш-токен

# Числовий id чату. НЕ @username.
#   1. Напишіть боту в потрібний чат (у приватний чат бот не пише першим,
#      тож спершу /start; у групі бот має бути учасником).
#   2. Відкрийте https://api.telegram.org/bot<ТОКЕН>/getUpdates
#   3. Візьміть message.chat.id
# У групи id від'ємний, у супергрупи починається з -100 — мінус обов'язковий.
TELEGRAM_CHAT_ID=-1001234567890

# Перевірка: py main.py --test-notify

# ── MongoDB (стан) ──────────────────────────────────────────────────────────
# Рядок підключення з Atlas: Connect → Drivers → Python.
# ⚠ Пароль треба percent-encode'ити: @ → %40, : → %3A, / → %2F тощо.
#   Найпростіше — створити користувача з паролем лише з букв і цифр.
# ⚠ Той самий рядок має бути секретом MONGODB_URI у GitHub Actions, інакше
#   хмара й домашня машина розійдуться по різних базах.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Назва бази. Можна не задавати — за замовчуванням olx_watcher.
# MONGODB_DB=olx_watcher

# Без MONGODB_URI код працює як раніше, зі state.json:
#     py main.py --storage json

# ── Букфлі (необов'язково) ──────────────────────────────────────────────────
# Потрібні лише якщо сайт колись почне ховати вміст від анонімів.
# BOOKFLEA_EMAIL=
# BOOKFLEA_PASSWORD=
# BOOKFLEA_COOKIE=

# ── E-mail замість/на додачу до Telegram (необов'язково) ────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TO=
